# --- Core -------------------------------------------------------------------
AFRIBIZ_DB=data/afribiz.db
AFRIBIZ_DATA_DIR=data
# Public HTTPS URL of this server (used for dashboard, invoice and lender links)
AFRIBIZ_PUBLIC_URL=https://your-domain.example
# Long random string. Signs dashboard/lender/file links and protects /admin/jobs
AFRIBIZ_SECRET=change-me-to-a-long-random-string
# Browser simulator at /simulator (turn off in production)
AFRIBIZ_ENABLE_SIMULATOR=true

# --- AI layer (optional; the rule engine works without it) -------------------
ANTHROPIC_API_KEY=
AFRIBIZ_LLM_ENABLED=true
AFRIBIZ_LLM_MODEL=claude-opus-5-5
# low | medium | high (low suits short chat turns)
AFRIBIZ_LLM_EFFORT=low
AFRIBIZ_LLM_HISTORY_TURNS=6

# --- WhatsApp Cloud API (Meta) -----------------------------------------------
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_GRAPH_VERSION=v21.0
# Approved template for the weekly debt digest outside the 24h window (optional)
WHATSAPP_REMINDER_TEMPLATE=

# --- Twilio (alternative WhatsApp/SMS provider) ------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=whatsapp:+14155238886

# --- Africa's Talking (USSD + SMS) -------------------------------------------
AT_USERNAME=sandbox
AT_API_KEY=
AT_SENDER_ID=

# --- Voice notes: any OpenAI-compatible /audio/transcriptions endpoint -------
AFRIBIZ_STT_URL=
AFRIBIZ_STT_API_KEY=
AFRIBIZ_STT_MODEL=whisper-1
